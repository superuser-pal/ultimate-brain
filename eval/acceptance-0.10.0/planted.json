{
  "as_of": "2026-12-01",
  "about": "CC-140: the planted problems of the 0.10.0 acceptance fixtures (harness/fixture.mjs). Each entry names its page ids, the signal that should find it and the evidence that makes it a finding at as_of; dates are days before as_of, so the entries hold for a sandbox made at any as_of. Signal names and rules are a reference reading of decision 0072 §3 and CC-140's task text; CC-108's contracts may rename or refine them, and this file follows. harness/check-planted.mjs checks a sandbox against this file.",
  "signals": {
    "task-stalled": {
      "days": 14,
      "group": "stalled",
      "rule": "an open task (not Done, Won't Do or Waiting On) whose last edit is 14 or more days before as_of"
    },
    "task-overdue": {
      "days": 3,
      "group": "overdue",
      "rule": "an open task (not Done, Won't Do or Waiting On) whose Due is 3 or more days before as_of"
    },
    "task-no-project": {
      "group": "structure",
      "rule": "an open task (not Done or Won't Do) with no Project"
    },
    "project-stalled": {
      "days": 21,
      "group": "stalled",
      "rule": "an Active project with no task done (a Done task's last edit) and no mention in the brain (a meeting's date, or the updated date of a note listing it in projects, or of its own note) in the 21 days before as_of"
    },
    "project-no-next-step": {
      "group": "no next step",
      "rule": "an Active project with no open task (Waiting On counts as open)"
    },
    "project-finished-open": {
      "group": "no next step",
      "rule": "an Active project with at least one task, every task Done or Won't Do and at least one Done; it has no open task either"
    },
    "project-wrong-area": {
      "group": "structure",
      "rule": "an Active project whose brain notes listing it in projects all have an Area, none of them the project's own"
    },
    "project-duplicate": {
      "similarity": 0.6,
      "group": "structure",
      "rule": "two projects not Done in the same Area whose names share most words: Jaccard of their lowercased words of 0.6 or more, without the, a, an, of, and, for, to, new; catalogue and catalog are one word"
    },
    "area-nothing-active": {
      "group": "structure",
      "rule": "an Area with no Active project and no open task (its own, or of one of its projects)"
    },
    "area-no-domain": {
      "group": "structure",
      "rule": "an Area with no Domain, with the Domains module on"
    }
  },
