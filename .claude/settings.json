{
  "permissions": {
    "allow": [
      "Bash(scripts/fetch-sources.sh:*)",
      "Bash(git -C sources/* log:*)",
      "Bash(git -C sources/* rev-parse:*)",
      "Read(sources/**)"
    ],
    "deny": [
      "Read(.env*)",
      "Bash(gh pr merge:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)"
    ]
  }
}
