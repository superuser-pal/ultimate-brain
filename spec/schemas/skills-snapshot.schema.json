{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-brain.dev/schemas/v1/skills-snapshot.schema.json",
  "title": "snapshot.json: a released skill snapshot (v1)",
  "description": "Manifest of an immutable operational-skill snapshot. See spec/skills-delivery.md §2 and decision 0059. Uniqueness of names and paths, sort order and integrity are checked by the reader (§2.3), not by this schema.",
  "type": "object",
  "required": [
    "format",
    "name",
    "version",
    "cli",
    "source",
    "upstream",
    "integrity",
    "skills"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1
    },
    "name": {
      "enum": [
        "ultimate-brain-skills",
        "ultimate-brain"
      ]
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "cli": {
      "type": "string",
      "pattern": "^(?:>=|>|<=|<|=)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?: (?:>=|>|<=|<|=)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)*$"
    },
    "source": {
      "type": "object",
      "required": [
        "repository"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "upstream": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "repository",
            "commit"
          ],
          "additionalProperties": false,
          "properties": {
            "repository": {
              "$ref": "#/$defs/repository"
            },
            "commit": {
              "$ref": "#/$defs/commit"
            }
          }
        }
      ]
    },
    "integrity": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "targets",
          "files"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "targets": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "enum": [
                "brain",
                "linked_repo"
              ]
            },
            "contains": {
              "const": "brain"
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "type": "object",
              "properties": {
                "path": {
                  "const": "SKILL.md"
                }
              },
              "required": [
                "path"
              ]
            },
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\\u0000]+(?:/[^/\\\\\\u0000]+)*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "name": {
            "const": "ultimate-brain-skills"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "type": "object",
            "required": [
              "commit"
            ],
            "properties": {
              "commit": {
                "$ref": "#/$defs/commit"
              }
            }
          },
          "upstream": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "upstream": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
