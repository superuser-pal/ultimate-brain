{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-brain.dev/schemas/v1/proposal.schema.json",
  "title": "Proposal frontmatter (v1)",
  "description": "A pending change to existing knowledge, mirrored as a Notion Review row. See spec/schema.md §11 and decision 0003.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "created",
    "updated",
    "kind",
    "why",
    "source",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^prp-[0-9abcdefghjkmnpqrstvwxyz]{8}$"
    },
    "type": {
      "const": "proposal"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "created": {
      "$ref": "note.schema.json#/$defs/date"
    },
    "updated": {
      "$ref": "note.schema.json#/$defs/date"
    },
    "kind": {
      "enum": [
        "update_fact",
        "add_to_note",
        "update_body",
        "add_link",
        "supersede",
        "contradiction",
        "merge",
        "new_item",
        "review_notes",
        "answer"
      ]
    },
    "target": {
      "$ref": "note.schema.json#/$defs/id"
    },
    "field": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "before": {
      "$ref": "note.schema.json#/$defs/factValue"
    },
    "after": {
      "$ref": "note.schema.json#/$defs/factValue"
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "before_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "supersedes": {
      "$ref": "note.schema.json#/$defs/id"
    },
    "merge_into": {
      "$ref": "note.schema.json#/$defs/id"
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "note.schema.json#/$defs/sourceKey"
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "edited",
        "applied",
        "closed"
      ]
    },
    "decision": {
      "type": "object",
      "required": [
        "action",
        "decided_at",
        "decided_by"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "approve",
            "reject",
            "fix",
            "edit"
          ]
        },
        "value": {
          "$ref": "note.schema.json#/$defs/factValue"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "fixes": {
          "description": "On fix: the corrected values the skill read from the What to fix text (spec/schema.md §11.3).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {},
              "change": {
                "type": "integer",
                "minimum": 0
              },
              "note": {
                "$ref": "note.schema.json#/$defs/id"
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "link": {
                "type": "object",
                "required": [
                  "field",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "target": {
                    "$ref": "note.schema.json#/$defs/id"
                  },
                  "field": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "note": {
                "$ref": "note.schema.json#/$defs/id"
              },
              "target": {
                "$ref": "note.schema.json#/$defs/id"
              },
              "field": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "change": {
                "type": "integer",
                "minimum": 0
              }
            },
            "oneOf": [
              {
                "required": [
                  "note"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "field"
                      ]
                    },
                    {
                      "required": [
                        "value"
                      ]
                    },
                    {
                      "required": [
                        "target"
                      ]
                    },
                    {
                      "required": [
                        "change"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "field",
                  "value"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "note"
                      ]
                    },
                    {
                      "required": [
                        "change"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "change"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "note"
                      ]
                    },
                    {
                      "required": [
                        "target"
                      ]
                    },
                    {
                      "required": [
                        "field"
                      ]
                    },
                    {
                      "required": [
                        "value"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "decided_at": {
          "$ref": "note.schema.json#/$defs/timestamp"
        },
        "decided_by": {
          "enum": [
            "notion",
            "chat"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "edit"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "fix"
              }
            }
          },
          "then": {
            "required": [
              "note",
              "fixes"
            ]
          }
        },
        {
          "if": {
            "required": [
              "fixes"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "const": "fix"
              }
            }
          }
        }
      ]
    },
    "notion": {
      "$ref": "note.schema.json#/$defs/notionPageId"
    },
    "from": {
      "$ref": "note.schema.json#/$defs/dateOrMonth"
    },
    "note": {
      "description": "For new_item: one `brain note new` input item without id (spec/cli.md §5.5).",
      "type": "object",
      "required": [
        "type",
        "title",
        "frontmatter",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "file_date": {
          "$ref": "note.schema.json#/$defs/date"
        },
        "frontmatter": {
          "type": "object"
        },
        "body": {
          "type": "string"
        }
      }
    },
    "closed_reason": {
      "enum": [
        "stale"
      ]
    },
    "notion_published": {
      "description": "Review property name → value last published (spec/cli.md §5.14).",
      "type": "object"
    },
    "links": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "field",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "target": {
            "$ref": "note.schema.json#/$defs/id"
          },
          "field": {
            "enum": [
              "aliases",
              "tags",
              "projects",
              "people",
              "attendees",
              "deciders"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "note.schema.json#/$defs/id"
      }
    },
    "changes": {
      "description": "review_notes only: the update_fact, update_body and add_to_note items of the same ingest, in render order (spec/schema.md §11.3).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "deferred_from": {
      "type": "string",
      "pattern": "^prp-[0-9abcdefghjkmnpqrstvwxyz]{8}$"
    },
    "dropped": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "change",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "change": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "const": "stale"
          }
        }
      }
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "answer_note": {
      "$ref": "note.schema.json#/$defs/id"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "update_fact"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "field",
          "after"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "contradiction"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "field",
          "before",
          "after"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "add_to_note"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "content"
        ],
        "not": {
          "required": [
            "note"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "update_body"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "content",
          "before_hash"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "field"
              ]
            },
            {
              "required": [
                "before"
              ]
            },
            {
              "required": [
                "after"
              ]
            },
            {
              "required": [
                "note"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "add_link"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "field": {
            "enum": [
              "aliases",
              "tags",
              "projects",
              "people",
              "attendees",
              "deciders"
            ]
          },
          "after": {
            "type": "string",
            "minLength": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "content"
              ]
            },
            {
              "required": [
                "note"
              ]
            },
            {
              "required": [
                "before"
              ]
            },
            {
              "required": [
                "notes"
              ]
            },
            {
              "required": [
                "answer"
              ]
            },
            {
              "required": [
                "answer_note"
              ]
            }
          ]
        },
        "oneOf": [
          {
            "required": [
              "links"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "field"
                  ]
                },
                {
                  "required": [
                    "after"
                  ]
                }
              ]
            },
            "properties": {
              "links": {
                "minItems": 1,
                "items": {
                  "not": {
                    "required": [
                      "target"
                    ]
                  }
                }
              }
            }
          },
          {
            "required": [
              "field",
              "after"
            ],
            "not": {
              "required": [
                "links"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "supersede"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "supersedes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "merge"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "merge_into"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "new_item"
          }
        }
      },
      "then": {
        "required": [
          "note"
        ],
        "not": {
          "required": [
            "content"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "decision"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "properties": {
              "action": {
                "enum": [
                  "approve"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "edited"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "properties": {
              "action": {
                "enum": [
                  "fix",
                  "edit"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "properties": {
              "action": {
                "enum": [
                  "reject"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "applied"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "properties": {
              "action": {
                "enum": [
                  "approve",
                  "fix",
                  "edit"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "closed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "decision"
        ],
        "anyOf": [
          {
            "properties": {
              "decision": {
                "properties": {
                  "action": {
                    "const": "reject"
                  }
                }
              }
            },
            "not": {
              "required": [
                "closed_reason"
              ]
            }
          },
          {
            "required": [
              "closed_reason"
            ],
            "properties": {
              "decision": {
                "properties": {
                  "action": {
                    "enum": [
                      "approve",
                      "fix",
                      "edit"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "action": {
                "const": "edit"
              }
            },
            "required": [
              "action"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "update_fact",
              "contradiction",
              "add_to_note",
              "update_body",
              "answer"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "closed_reason"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "closed"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "links"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "add_link",
              "review_notes"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "required": [
              "exclude"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "add_link",
              "review_notes"
            ]
          },
          "decision": {
            "properties": {
              "action": {
                "enum": [
                  "approve",
                  "fix"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review_notes"
          }
        }
      },
      "then": {
        "required": [
          "notes",
          "links"
        ],
        "properties": {
          "links": {
            "items": {
              "required": [
                "target"
              ]
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "notes": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "links": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "changes"
            ],
            "properties": {
              "changes": {
                "minItems": 1
              }
            }
          }
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "target"
              ]
            },
            {
              "required": [
                "field"
              ]
            },
            {
              "required": [
                "before"
              ]
            },
            {
              "required": [
                "after"
              ]
            },
            {
              "required": [
                "content"
              ]
            },
            {
              "required": [
                "note"
              ]
            },
            {
              "required": [
                "supersedes"
              ]
            },
            {
              "required": [
                "merge_into"
              ]
            },
            {
              "required": [
                "answer"
              ]
            },
            {
              "required": [
                "answer_note"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "answer"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "answer"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "field"
              ]
            },
            {
              "required": [
                "before"
              ]
            },
            {
              "required": [
                "after"
              ]
            },
            {
              "required": [
                "content"
              ]
            },
            {
              "required": [
                "note"
              ]
            },
            {
              "required": [
                "links"
              ]
            },
            {
              "required": [
                "notes"
              ]
            },
            {
              "required": [
                "supersedes"
              ]
            },
            {
              "required": [
                "merge_into"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "notes"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "review_notes"
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "answer"
            ]
          },
          {
            "required": [
              "answer_note"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "answer"
          }
        }
      }
    },
    {
      "description": "exclude entries fit the kind: {field, value} on add_link, {note} or {target, field, value} on review_notes.",
      "if": {
        "required": [
          "kind",
          "decision"
        ],
        "properties": {
          "kind": {
            "const": "add_link"
          },
          "decision": {
            "required": [
              "exclude"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "exclude": {
                "items": {
                  "required": [
                    "field",
                    "value"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "target"
                        ]
                      },
                      {
                        "required": [
                          "note"
                        ]
                      },
                      {
                        "required": [
                          "change"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind",
          "decision"
        ],
        "properties": {
          "kind": {
            "const": "review_notes"
          },
          "decision": {
            "required": [
              "exclude"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "exclude": {
                "items": {
                  "anyOf": [
                    {
                      "required": [
                        "note"
                      ]
                    },
                    {
                      "required": [
                        "target",
                        "field",
                        "value"
                      ]
                    },
                    {
                      "required": [
                        "change"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "before_hash"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "update_body"
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
