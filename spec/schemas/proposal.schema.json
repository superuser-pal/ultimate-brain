{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-brain.dev/schemas/v1/proposal.schema.json",
  "title": "Proposal frontmatter (v1)",
  "description": "A pending change to existing knowledge, mirrored as a Notion Review row. See spec/schema.md §11 and decision 0003.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "created",
    "updated",
    "kind",
    "why",
    "source",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^prp-[0-9abcdefghjkmnpqrstvwxyz]{8}$"
    },
    "type": {
      "const": "proposal"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "created": {
      "$ref": "note.schema.json#/$defs/date"
    },
    "updated": {
      "$ref": "note.schema.json#/$defs/date"
    },
    "kind": {
      "enum": [
        "update_fact",
        "add_to_note",
        "update_body",
        "add_link",
        "supersede",
        "contradiction",
        "merge",
        "new_item",
        "review_notes",
        "answer",
        "notion_change",
        "set_field"
      ]
    },
    "target": {
      "$ref": "note.schema.json#/$defs/id"
    },
    "field": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "before": {
      "$ref": "note.schema.json#/$defs/factValue"
    },
    "after": {
      "$ref": "note.schema.json#/$defs/factValue"
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "before_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "supersedes": {
      "$ref": "note.schema.json#/$defs/id"
    },
    "merge_into": {
      "$ref": "note.schema.json#/$defs/id"
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "note.schema.json#/$defs/sourceKey"
    },
    "passages": {
      "description": "0.13.0 on (0077 §3, spec/schema.md §11.5, eligibility.md §9.1): the passages the change rests on. Absent on a legacy proposal, written before the field, and on a review_notes (its items carry them) and a notion_change.",
      "$ref": "#/$defs/passages"
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "edited",
        "applied",
        "closed"
      ]
    },
    "decision": {
      "type": "object",
      "required": [
        "action",
        "decided_at",
        "decided_by"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "approve",
            "reject",
            "fix",
            "edit"
          ]
        },
        "value": {
          "$ref": "note.schema.json#/$defs/factValue"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "fixes": {
          "description": "On fix: the corrected values the skill read from the What to fix text (spec/schema.md §11.3).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {},
              "change": {
                "type": "integer",
                "minimum": 0
              },
              "note": {
                "$ref": "note.schema.json#/$defs/id"
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "link": {
                "type": "object",
                "required": [
                  "field",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "target": {
                    "$ref": "note.schema.json#/$defs/id"
                  },
                  "field": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "note": {
                "$ref": "note.schema.json#/$defs/id"
              },
              "target": {
                "$ref": "note.schema.json#/$defs/id"
              },
              "field": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "change": {
                "type": "integer",
                "minimum": 0
              }
            },
            "oneOf": [
              {
                "required": [
                  "note"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "field"
                      ]
                    },
                    {
                      "required": [
                        "value"
                      ]
                    },
                    {
                      "required": [
                        "target"
                      ]
                    },
                    {
                      "required": [
                        "change"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "field",
                  "value"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "note"
                      ]
                    },
                    {
                      "required": [
                        "change"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "change"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "note"
                      ]
                    },
                    {
                      "required": [
                        "target"
                      ]
                    },
                    {
                      "required": [
                        "field"
                      ]
                    },
                    {
                      "required": [
                        "value"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "decided_at": {
          "$ref": "note.schema.json#/$defs/timestamp"
        },
        "decided_by": {
          "enum": [
            "notion",
            "chat"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "edit"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "fix"
              }
            }
          },
          "then": {
            "required": [
              "note",
              "fixes"
            ]
          }
        },
        {
          "if": {
            "required": [
              "fixes"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "const": "fix"
              }
            }
          }
        }
      ]
    },
    "notion": {
      "$ref": "note.schema.json#/$defs/notionPageId"
    },
    "from": {
      "$ref": "note.schema.json#/$defs/dateOrMonth"
    },
    "note": {
      "description": "For new_item: one `brain note new` input item without id (spec/cli.md §5.5).",
      "type": "object",
      "required": [
        "type",
        "title",
        "frontmatter",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "file_date": {
          "$ref": "note.schema.json#/$defs/date"
        },
        "frontmatter": {
          "type": "object"
        },
        "body": {
          "type": "string"
        }
      }
    },
    "closed_reason": {
      "enum": [
        "stale"
      ]
    },
    "notion_published": {
      "description": "Review property name → value last published (spec/cli.md §5.14).",
      "type": "object"
    },
    "links": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "field",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "target": {
            "$ref": "note.schema.json#/$defs/id"
          },
          "field": {
            "enum": [
              "aliases",
              "tags",
              "projects",
              "people",
              "attendees",
              "deciders"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "note.schema.json#/$defs/id"
      }
    },
    "changes": {
      "description": "review_notes only: the update_fact, update_body and add_to_note items of the same ingest, in render order (spec/schema.md §11.3).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "items": {
      "description": "review_notes only (0055, capture-and-review §7.2): the independently decidable items, in the order the Review row lists them (changes, notes, links; spec/schema.md §11.3). `item_id` is immutable. Absent on a proposal written before 0.8.0, which keeps the 0045 behavior (§7.9).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "kind", "ref"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string", "pattern": "^it-[0-9abcdefghjkmnpqrstvwxyz]{8}$" },
          "kind": { "enum": ["note", "link", "change", "remove", "restore", "independence"] },
          "n": { "description": "restore only: the paragraph number to restore.", "type": "integer", "minimum": 1 },
          "ref": { "description": "A note id (kind note), an index into links or changes, or (a grouped link item, from 0.15.0) a list of indexes into links that share one target and field.", "anyOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "note.schema.json#/$defs/id" }, { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } }] },
          "passages": { "description": "note, link and change items from 0.13.0 on: the item's passages (spec/schema.md §11.5). An item without them is legacy.", "$ref": "#/$defs/passages" },
          "unsure": { "description": "0.15.0 (capture-and-review §7.12.8): one-line flags the ingest judged.", "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" } },
          "repeat": { "description": "0.15.0: a short key shared by the items that record the same thing.", "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" }
        }
      }
    },
    "revisions": {
      "description": "review_notes only (capture-and-review §7.8): a Request revision per item. `requested` holds the user's instruction; `drafted` means the stored proposal was replaced by a new draft, and `previous` keeps the wording the user had in the Proposed toggle.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "instruction", "requested_at", "status"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string", "pattern": "^it-[0-9abcdefghjkmnpqrstvwxyz]{8}$" },
          "instruction": { "type": "string", "minLength": 1 },
          "requested_at": { "$ref": "note.schema.json#/$defs/timestamp" },
          "status": { "enum": ["requested", "drafted"] },
          "previous": { "type": "string" },
          "drafted_at": { "$ref": "note.schema.json#/$defs/timestamp" }
        }
      }
    },
    "cleanup": {
      "description": "review_notes only (capture-and-review §5.2): this is the exclusion cleanup row of an input. Its items are remove, restore and independence; `tasks` lists the Tasks created from excluded content, for the user to act on in Notion.",
      "type": "object",
      "required": ["input"],
      "additionalProperties": false,
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "tasks": { "type": "array", "items": { "type": "object" } }
      }
    },
    "item_decisions": {
      "description": "review_notes only: decided items, written in the same commit as their write set (capture-and-review §7.6).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "decision", "decided_at", "decided_by"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string", "pattern": "^it-[0-9abcdefghjkmnpqrstvwxyz]{8}$" },
          "decision": { "enum": ["accept", "reject", "defer"] },
          "decided_at": { "$ref": "note.schema.json#/$defs/timestamp" },
          "decided_by": { "enum": ["notion", "chat"] },
          "proposed_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "base_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "snapshot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "state": { "enum": ["applied", "closed", "deferred"] },
          "deferred_to": { "type": "string", "pattern": "^prp-[0-9abcdefghjkmnpqrstvwxyz]{8}$" },
          "reason": { "enum": ["source_excluded"] },
          "edited": { "type": "boolean" },
          "agreed": { "description": "format 2 (capture-and-review §7.12.6): the Agreed in review lines of the item's section, never hashed.", "type": "string", "minLength": 1 },
          "values": { "description": "an accepted grouped link item from which values were deleted: the indexes into links that were added.", "type": "array", "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "deferred_from": {
      "type": "string",
      "pattern": "^prp-[0-9abcdefghjkmnpqrstvwxyz]{8}$"
    },
    "dropped": {
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "stale: a change whose target changed first (spec/schema.md §11.3). source_excluded: an item of a review_notes without items, withheld for want of eligible support (§11.5); a note or a link is only ever source_excluded.",
        "type": "object",
        "required": [
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "change": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "$ref": "note.schema.json#/$defs/id"
          },
          "link": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "enum": ["stale", "source_excluded"]
          }
        },
        "oneOf": [
          {"required": ["change"]},
          {"required": ["note"], "properties": {"reason": {"const": "source_excluded"}}},
          {"required": ["link"], "properties": {"reason": {"const": "source_excluded"}}}
        ]
      }
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "answer_note": {
      "$ref": "note.schema.json#/$defs/id"
    },
    "database": {
      "description": "notion_change: the Notion database of page (spec/schema.md §11, spec/assistant.md §6).",
      "enum": ["tasks", "projects", "areas"]
    },
    "page": { "description": "notion_change: the Notion page id, dashed and lowercase.", "$ref": "#/$defs/pageId" },
    "page_title": { "description": "notion_change: the row's Name when proposed.", "type": "string", "minLength": 1 },
    "property": {
      "description": "notion_change: tasks take status, due, project, area; projects status, archived; areas archived.",
      "enum": ["status", "due", "project", "area", "archived"]
    },
    "value_before": { "description": "notion_change: the value read when proposed; its shape follows property.", "$ref": "#/$defs/notionValue" },
    "value_after": { "description": "notion_change: the value to write; its shape follows property.", "$ref": "#/$defs/notionValue" },
    "area": { "description": "notion_change and set_field: the Area whose home shows the Review row.", "type": "string", "pattern": "^area-[0-9abcdefghjkmnpqrstvwxyz]{8}$" },
    "finding": { "description": "The Ultimate Assistant finding key (spec/assistant.md §3.3); the same pattern as assistant.schema.json $defs/findingKey.", "$ref": "#/$defs/findingKey" },
    "fingerprint": { "description": "The reflection finding the proposal records (spec/schema.md §11.4, decisions 0052 and 0076): <finding kind>:<ids or term>[:<field or source>].", "$ref": "#/$defs/fingerprint" },
    "evidence": { "description": "Reflection: the meetings and sources the finding rested on when the user answered it, sorted and unique (spec/schema.md §11.4); may be empty (a duplicate rests on names).", "type": "array", "items": { "type": "string", "pattern": "^(mtg|src)-[0-9abcdefghjkmnpqrstvwxyz]{8}$" }, "uniqueItems": true }
  },
  "additionalProperties": false,
  "allOf": [
    {"description": "A reflection proposal (0052, 0076) carries its fingerprint and its evidence together, and is never an Ultimate Assistant one.", "if": {"anyOf": [{"required": ["fingerprint"]}, {"required": ["evidence"]}]}, "then": {"required": ["fingerprint", "evidence"], "not": {"required": ["finding"]}}},
    {"description": "contradiction:<target>:<field> is a contradiction on that target and field.", "if": {"properties": {"fingerprint": {"pattern": "^contradiction:"}}, "required": ["fingerprint"]}, "then": {"properties": {"kind": {"const": "contradiction"}}}},
    {"description": "stale:<target>:<field> is an update_fact on that target and field.", "if": {"properties": {"fingerprint": {"pattern": "^stale:"}}, "required": ["fingerprint"]}, "then": {"properties": {"kind": {"const": "update_fact"}}}},
    {"description": "merge:<id>+<id> is a merge of those two notes.", "if": {"properties": {"fingerprint": {"pattern": "^merge:"}}, "required": ["fingerprint"]}, "then": {"properties": {"kind": {"const": "merge"}}}},
    {"description": "promotion:<target>:<source> is an add_to_note on that target from that source.", "if": {"properties": {"fingerprint": {"pattern": "^promotion:"}}, "required": ["fingerprint"]}, "then": {"properties": {"kind": {"const": "add_to_note"}}}},
    {"description": "theme:<term> is the draft learned Document's review_notes (a yes or later), or a new_item (a skip).", "if": {"properties": {"fingerprint": {"pattern": "^theme:"}}, "required": ["fingerprint"]}, "then": {"properties": {"kind": {"enum": ["review_notes", "new_item"]}}}},
    {"description": "notion_change (0072): its own fields, no fact or note fields.", "if": {"properties": {"kind": {"const": "notion_change"}}, "required": ["kind"]}, "then": {"required": ["database", "page", "page_title", "property", "value_before", "value_after"], "not": {"anyOf": [{"required": ["field"]}, {"required": ["before"]}, {"required": ["after"]}, {"required": ["content"]}, {"required": ["note"]}, {"required": ["links"]}, {"required": ["notes"]}, {"required": ["changes"]}, {"required": ["supersedes"]}, {"required": ["merge_into"]}, {"required": ["answer"]}, {"required": ["answer_note"]}, {"required": ["passages"]}]}}},
    {"description": "A review_notes names its passages per item (spec/schema.md §11.5), not as a whole.", "if": {"properties": {"kind": {"const": "review_notes"}}, "required": ["kind"]}, "then": {"not": {"required": ["passages"]}}},
    {"description": "notion_change fields belong to notion_change only.", "if": {"anyOf": [{"required": ["database"]}, {"required": ["page"]}, {"required": ["page_title"]}, {"required": ["property"]}, {"required": ["value_before"]}, {"required": ["value_after"]}]}, "then": {"properties": {"kind": {"const": "notion_change"}}}},
    {"description": "area belongs to notion_change and set_field only.", "if": {"required": ["area"]}, "then": {"properties": {"kind": {"enum": ["notion_change", "set_field"]}}}},
    {"description": "A task has no note: no target; tasks take status, due, project, area.", "if": {"properties": {"database": {"const": "tasks"}}, "required": ["database"]}, "then": {"not": {"required": ["target"]}, "properties": {"property": {"enum": ["status", "due", "project", "area"]}}}},
    {"description": "projects: the project note is the target; Status or Archived.", "if": {"properties": {"database": {"const": "projects"}}, "required": ["database"]}, "then": {"required": ["target"], "properties": {"target": {"pattern": "^prj-"}, "property": {"enum": ["status", "archived"]}}}},
    {"description": "areas: the Area note is the target; Archived only.", "if": {"properties": {"database": {"const": "areas"}}, "required": ["database"]}, "then": {"required": ["target"], "properties": {"target": {"pattern": "^area-"}, "property": {"const": "archived"}}}},
    {"description": "status: a string, or null before; never null after.", "if": {"properties": {"property": {"const": "status"}}, "required": ["property"]}, "then": {"properties": {"value_before": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "value_after": {"type": "string", "minLength": 1}}}},
    {"description": "A project's Status is one of its four options.", "if": {"properties": {"database": {"const": "projects"}, "property": {"const": "status"}}, "required": ["database", "property"]}, "then": {"properties": {"value_before": {"enum": ["Planned", "Active", "On Hold", "Done", null]}, "value_after": {"enum": ["Planned", "Active", "On Hold", "Done"]}}}},
    {"description": "due: a date or null.", "if": {"properties": {"property": {"const": "due"}}, "required": ["property"]}, "then": {"properties": {"value_before": {"anyOf": [{"$ref": "note.schema.json#/$defs/date"}, {"type": "null"}]}, "value_after": {"anyOf": [{"$ref": "note.schema.json#/$defs/date"}, {"type": "null"}]}}}},
    {"description": "project and area: a sorted, duplicate-free list of page ids.", "if": {"properties": {"property": {"enum": ["project", "area"]}}, "required": ["property"]}, "then": {"properties": {"value_before": {"$ref": "#/$defs/pageIds"}, "value_after": {"$ref": "#/$defs/pageIds"}}}},
    {"description": "archived: a boolean.", "if": {"properties": {"property": {"const": "archived"}}, "required": ["property"]}, "then": {"properties": {"value_before": {"type": "boolean"}, "value_after": {"type": "boolean"}}}},
    {"description": "set_field (0072): a project's area or an Area's domain, as note ids.", "if": {"properties": {"kind": {"const": "set_field"}}, "required": ["kind"]}, "then": {"required": ["target", "field", "after"], "properties": {"field": {"enum": ["area", "domain"]}}, "not": {"anyOf": [{"required": ["content"]}, {"required": ["note"]}, {"required": ["links"]}, {"required": ["notes"]}, {"required": ["changes"]}, {"required": ["supersedes"]}, {"required": ["merge_into"]}, {"required": ["answer"]}, {"required": ["answer_note"]}, {"required": ["from"]}]}}},
    {"if": {"properties": {"kind": {"const": "set_field"}, "field": {"const": "area"}}, "required": ["kind", "field"]}, "then": {"properties": {"target": {"pattern": "^prj-"}, "before": {"type": "string", "pattern": "^area-[0-9abcdefghjkmnpqrstvwxyz]{8}$"}, "after": {"type": "string", "pattern": "^area-[0-9abcdefghjkmnpqrstvwxyz]{8}$"}}}},
    {"if": {"properties": {"kind": {"const": "set_field"}, "field": {"const": "domain"}}, "required": ["kind", "field"]}, "then": {"properties": {"target": {"pattern": "^area-"}, "before": {"type": "string", "pattern": "^dom-[0-9abcdefghjkmnpqrstvwxyz]{8}$"}, "after": {"type": "string", "pattern": "^dom-[0-9abcdefghjkmnpqrstvwxyz]{8}$"}}}},
    {
      "if": {
        "properties": {
          "kind": {
            "const": "update_fact"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "field",
          "after"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "contradiction"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "field",
          "before",
          "after"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "add_to_note"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "content"
        ],
        "not": {
          "required": [
            "note"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "update_body"
          }
        }
      },
      "then": {
