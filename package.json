{
  "name": "ultimate-brain",
  "version": "0.14.0-rc.2",
  "description": "CLI for an AI-assisted Markdown and Git second brain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superuser-pal/ultimate-brain.git"
  },
  "keywords": [
    "second-brain",
    "knowledge-management",
    "markdown",
    "notion",
    "claude-code",
    "codex",
    "cli"
  ],
  "type": "module",
  "bin": {
    "ultimate-brain": "bin/brain.js",
    "brain": "bin/brain.js"
  },
  "files": [
    "bin",
    "dist",
    "spec/schemas",
    "templates/brain",
    "templates/repo",
    ".agents/skills",
    "notion",
    "docs/notion-space-design.md",
    "docs/setup.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node --experimental-strip-types scripts/vendor-skills.mjs --check",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "test:scripts": "node --test tests/release-scripts.test.mjs",
    "pretest": "node --experimental-strip-types scripts/vendor-skills.mjs --check",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
