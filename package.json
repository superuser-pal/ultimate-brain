{
  "name": "ultimate-brain",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "spec/schemas",
    "templates/brain",
    "README.md"
  ],
  "description": "CLI for an AI-assisted Markdown and Git second brain",
  "type": "module",
  "bin": {
    "ultimate-brain": "./dist/cli.js",
    "brain": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.9.1"
  }
}
